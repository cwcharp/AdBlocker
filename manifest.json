{
    "manifest_version": 3,
    "name": "My Extension",
    "version": "0.0.1",
    "author": "Cole Charpentier",
    "description": "A simple Chrome extension for blocking ads",
    "permissions": [
        "tabs",
        "webNavigation",
        "scripting"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}